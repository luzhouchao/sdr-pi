# Non-secret planner settings. The systemd unit injects the token path through
# LoadCredential; the token never belongs in this file or repository.
SDR_PLANNER_BASE_URL=http://100.104.138.63:27879/v1
SDR_PLANNER_PROVIDER=qwen4090
SDR_PLANNER_MODEL=qwen3.8-27b
SDR_PLANNER_SOCKET=/run/sdr-agent/planner.sock
SDR_SESSION_SOCKET=/run/sdr-agent/session.sock

# Keep the Pi worker bounded. Qwen inference and KV cache remain on the 4090.
SDR_PLANNER_CONTEXT_WINDOW=196608
SDR_PLANNER_MAX_TOKENS=1024
SDR_PLANNER_TIMEOUT_MS=30000
# Optional local SearXNG host tool for the Spark structured-output adapter.
# Only explicit 127.0.0.1 or ::1 HTTP endpoints are accepted.
# SDR_PLANNER_WEB_SEARCH_URL=http://127.0.0.1:8080
# SDR_PLANNER_WEB_SEARCH_MAX_RESULTS=8
# SDR_PLANNER_WEB_SEARCH_MAX_SEARCHES=2
# SDR_PLANNER_WEB_SEARCH_TIMEOUT_MS=15000

PI_TELEMETRY=0
PI_SKIP_VERSION_CHECK=1
