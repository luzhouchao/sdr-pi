[Unit]
Description=SDR Agent Tailnet web console
After=network-online.target tailscaled.service sdr-agent-planner.service
Wants=network-online.target
Requires=sdr-agent-planner.service

[Service]
Type=simple
User=root
Group=root
Environment=SDR_WEB_LISTEN_HOST=100.102.130.52
Environment=SDR_WEB_LISTEN_PORT=8787
Environment=SDR_WEB_STATE_PATH=/var/lib/sdr-agent/web-console/state.json
Environment=SDR_WEB_AGENT_BINARY=/opt/sdr-agent/current/bin/sdr-agent
Environment=SDR_WEB_REQUEST_PATH=/etc/sdr-agent/request.json
Environment=SDR_WEB_SESSION_SOCKET=/run/sdr-agent/session.sock
Environment=SDR_WEB_SDRD_ADDRESS=192.168.1.10:43110
Environment=SDR_WEB_CORPUS_ROOT=/var/lib/sdrharness/web-console/p201-corpus
ExecStart=/opt/sdr-agent/current/bin/sdr-agent-web-console
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
StateDirectory=sdr-agent/web-console
StateDirectoryMode=0700

MemoryHigh=48M
MemoryMax=64M
CPUQuota=20%
TasksMax=48

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
