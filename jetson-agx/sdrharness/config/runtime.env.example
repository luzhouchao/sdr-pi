# Non-secret AGX SDR Harness settings. Do not add API keys here.
# Fail-closed fallback only. Configure the real third-party upstream from the
# trusted-LAN Web Console before opening a conversation.
SDR_PLANNER_API=openai-completions
SDR_PLANNER_BASE_URL=https://api.example.invalid/v1
SDR_PLANNER_PROVIDER=third-party
SDR_PLANNER_MODEL=configure-in-web
SDR_PLANNER_PROVIDER_CONFIG=/var/lib/sdrharness/web-console/provider.json
SDR_PLANNER_SOCKET=/run/sdr-agent/planner.sock
SDR_SESSION_SOCKET=/run/sdr-agent/session.sock
SDR_PLANNER_CONTEXT_WINDOW=131072
SDR_PLANNER_MAX_TOKENS=1024
SDR_PLANNER_TIMEOUT_MS=30000
PI_TELEMETRY=0
PI_SKIP_VERSION_CHECK=1

# User-authorized all-interface LAN bind. This survives LAN address changes but
# also exposes the Web Console on every AGX IPv4 interface; never port-forward
# this listener to the public Internet.
SDR_WEB_LISTEN_HOST=0.0.0.0
SDR_WEB_LISTEN_PORT=8787
SDR_WEB_STATE_PATH=/var/lib/sdrharness/web-console/state.json
SDR_WEB_AGENT_BINARY=/home/jetson/.local/lib/sdrharness/bin/sdr-agent
SDR_WEB_REQUEST_PATH=/etc/sdrharness/request.json
SDR_WEB_SESSION_SOCKET=/run/sdr-agent/session.sock
SDR_WEB_SDRD_ADDRESS=192.168.1.10:43110
SDR_WEB_PROVIDER_CONFIG_PATH=/var/lib/sdrharness/web-console/provider.json
