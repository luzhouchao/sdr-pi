# Non-secret AGX SDR Harness settings. Do not add API keys here.
SDR_PLANNER_BASE_URL=http://127.0.0.1:8000/v1
SDR_PLANNER_PROVIDER=qwen-agx
SDR_PLANNER_MODEL=qwen3.8-27b
SDR_PLANNER_SOCKET=/run/sdrharness/planner.sock
SDR_SESSION_SOCKET=/run/sdrharness/session.sock
SDR_PLANNER_CONTEXT_WINDOW=131072
SDR_PLANNER_MAX_TOKENS=1024
SDR_PLANNER_TIMEOUT_MS=30000
PI_TELEMETRY=0
PI_SKIP_VERSION_CHECK=1

# Safe default: local browser only. Replace with the AGX Tailscale IPv4 after
# verifying the interface; never use 0.0.0.0 merely for convenience.
SDR_WEB_LISTEN_HOST=127.0.0.1
SDR_WEB_LISTEN_PORT=8787
SDR_WEB_STATE_PATH=/var/lib/sdrharness/web-console/state.json
SDR_WEB_AGENT_BINARY=/home/jetson/.local/lib/sdrharness/bin/sdr-agent
SDR_WEB_REQUEST_PATH=/etc/sdrharness/request.json
SDR_WEB_SESSION_SOCKET=/run/sdrharness/session.sock
SDR_WEB_SDRD_ADDRESS=192.168.1.10:43110
